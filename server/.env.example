PORT=3001
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Configure only when the server is behind a trusted reverse proxy.
# Examples: 1 for one proxy hop, or a trusted subnet/address.
# TRUST_PROXY=1

# The current VIP endpoint is a demo flow. It is disabled by default in production.
# Set this only when an external payment/entitlement layer protects the endpoint.
ENABLE_SELF_SERVICE_VIP=false

# Outbound request deadlines in milliseconds.
EXTERNAL_REQUEST_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=15000

# MongoDB Atlas example:
# 1. Replace <username>, <password>, and <cluster-url>.
# 2. Keep the database name after the slash, here it is agent_search.
# 3. URL-encode special characters in your password, such as @ -> %40.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/agent_search?retryWrites=true&w=majority

# Optional: set this when your connection string does not include the target database
# or when you want to override the database name from MONGODB_URI.
MONGODB_DB_NAME=agent_search

GOOGLE_API_KEY=replace-with-google-places-api-key
GOOGLE_ROUTE_API_KEY=replace-with-google-routes-api-key
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
SERP_API_KEY=replace-with-serpapi-key

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,https://seven03-practice.onrender.com
